# ==========================================
# BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace with your actual keys
# ==========================================

# Anthropic / Claude API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key
GROQ_API_KEY=your_groq_api_key_here

# Google AI Studio / Gemini API Key
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_api_key_here

# Cloudflare Configuration & R2 Storage
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id_here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
CLOUDFLARE_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# AssemblyAI Speech-to-Text API Key
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Sarvam AI API Key
SARVAM_API_KEY=your_sarvam_api_key_here

# Bolna AI Voice Agent API Key
BOLNA_API_KEY=your_bolna_api_key_here

# Smallest AI Voice Cloning & TTS (Exclusive Zaroon AI Voice)
SMALLEST_API_KEY=your_smallest_ai_api_key_here
ZAROON_VOICE_ID=your_cloned_zaroon_voice_id_here

# Supabase Database & Auth Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# ==========================================
# HUGGING FACE INFERENCE & HUB CONFIGURATION
# ==========================================
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HF_TOKEN=your_hf_token_here

# Hugging Face Model Identifiers
HF_MODEL_TINYLLAMA=TinyLlama/TinyLlama-1.1B-Chat-v1.0
HF_MODEL_LLAMA=meta-llama/Meta-Llama-3.1-8B-Instruct
HF_MODEL_GEMMA=google/gemma-2-9b-it
HF_MODEL_QWEN=Qwen/Qwen2.5-7B-Instruct
HF_MODEL_QWEN_CODER=Qwen/Qwen2.5-Coder-7B-Instruct
HF_MODEL_MISTRAL=mistralai/Mistral-7B-Instruct-v0.3
HF_MODEL_PHI=microsoft/Phi-3.5-mini-instruct
HF_MODEL_DEEPSEEK=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
HF_MODEL_EMBEDDING=sentence-transformers/all-MiniLM-L6-v2

# ==========================================
# OLLAMA LOCAL / REMOTE LLM RUNTIME
# ==========================================
OLLAMA_BASE_URL=http://localhost:11434

# Ollama Model Identifiers
OLLAMA_MODEL_TINYLLAMA=tinyllama
OLLAMA_MODEL_LLAMA=llama3.2
OLLAMA_MODEL_GEMMA=gemma2
OLLAMA_MODEL_QWEN=qwen2.5
OLLAMA_MODEL_QWEN_CODER=qwen2.5-coder
OLLAMA_MODEL_MISTRAL=mistral
OLLAMA_MODEL_PHI=phi3.5
OLLAMA_MODEL_DEEPSEEK=deepseek-r1
OLLAMA_MODEL_EMBEDDING=nomic-embed-text

# ==========================================
# CLERK AUTHENTICATION CONFIGURATION
# ==========================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/candidate-portal.html
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/candidate-portal.html


